# ---------------------------------------------------------------------------
# Copy to .env and fill in.  Never commit .env.
#   cp .env.example .env
#
# IMPORTANT: comments must be on their own line. django-environ does NOT strip
# a trailing "# ..." from a value, so `S3_REGION=auto  # comment` is read as the
# literal string 'auto  # comment' and fails in a confusing place far from here.
# Values are also left unquoted for the same reason.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev
# Comma-separated. In production this must be your real domain, never "*".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production: the https origin(s) Caddy serves, for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Production starts with a one-hour HSTS window and does not include subdomains
# or request browser preload. Raise these only after every hostname is HTTPS.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Idle timeout for a session on the shared store phone, in minutes.
SESSION_IDLE_MINUTES=30

# --- Database -------------------------------------------------------------
# Host port 5433, not 5432: this machine already runs a native Postgres service
# on 5432, and docker-compose.yml deliberately avoids the collision.
DATABASE_URL=postgres://store_ops:store_ops_dev_password@localhost:5433/store_ops

# compose.prod.yml requires these in the production .env. Backing services are
# internal-only; STORE_DOMAIN is the public hostname Caddy obtains TLS for.
STORE_DOMAIN=
POSTGRES_USER=store_ops
POSTGRES_PASSWORD=
POSTGRES_DB=store_ops

# --- Background jobs (Celery + Redis) -------------------------------------
REDIS_URL=redis://localhost:6379/0
# Run extraction inline instead of queueing it. Useful for local debugging;
# never true in production, it blocks the employee's phone for ~20 seconds.
CELERY_TASK_ALWAYS_EAGER=false

# --- Square ---------------------------------------------------------------
# The Python SDK is the "squareup" package on PyPI, imported as `square`.
# ("square" on npm is the unrelated Node SDK.)
# Start in sandbox: squareup.com/dashboard/apps -> your app -> Sandbox.
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
# The store's Square location.
SQUARE_LOCATION_ID=
# For verifying inbound webhooks.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Hard safety gate. Leave false until invoice mappings have been reviewed in
# the Square sandbox and the owner is ready to enable explicit inventory posts.
SQUARE_INVENTORY_WRITES_ENABLED=false
# Separate paid-plan-sensitive gate. When true, only a validated full line
# receipt total is sent; per-bottle cost and retail sale price are never used.
SQUARE_INVENTORY_COST_WRITES_ENABLED=false
SQUARE_CATALOG_WRITES_ENABLED=false
SQUARE_CATALOG_CREATE_STALE_SECONDS=900
SQUARE_PUSH_STALE_SECONDS=900

# --- Vision extraction ----------------------------------------------------
EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-6-astra
OPENAI_EXTRACTION_FALLBACK_MODEL=gpt-5.6-terra
# Optional future provider. The current implementation ships with OpenAI and a
# provider interface so Anthropic/Google can be benchmarked without changing
# the capture or review workflow.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
ANTHROPIC_EXTRACTION_FALLBACK_MODEL=claude-opus-5-5
# Optional self-hosted Managed Agents inventory demo. Leave disabled until a
# Linux, per-session sandbox launcher and worker have been deployed according
# to docs/claude-self-hosted-inventory.md.
CLAUDE_INVENTORY_SANDBOX_ENABLED=false
CLAUDE_INVENTORY_SANDBOX_PRIMARY=false
CLAUDE_INVENTORY_AGENT_ID=
CLAUDE_INVENTORY_ENVIRONMENT_ID=
# Hard list-cost ceiling in cents for one invoice session ($2.50 by default).
CLAUDE_INVENTORY_MAX_COST_CENTS=250
CLAUDE_INVENTORY_MAX_RESULT_JSON_BYTES=2097152
CLAUDE_INVENTORY_MAX_WORKBOOK_BYTES=26214400
# Separate trusted-host launcher gate and locked-down per-session container.
# This launcher is Linux-only. Use a dedicated Docker network whose host
# firewall/proxy allows only the Anthropic control-plane endpoints.
CLAUDE_INVENTORY_LAUNCHER_ENABLED=false
CLAUDE_INVENTORY_WORKSPACE_ROOT=/var/lib/store-ops/claude-inventory
CLAUDE_INVENTORY_DOCKER_IMAGE=
CLAUDE_INVENTORY_DOCKER_NETWORK=
# Leave blank to use the non-root launcher's numeric uid:gid on Linux.
CLAUDE_INVENTORY_DOCKER_USER=
CLAUDE_INVENTORY_DOCKER_PYTHON=/app/.venv/bin/python
# Keep true outside a local demo; production should use image@sha256:<digest>.
CLAUDE_INVENTORY_DOCKER_REQUIRE_DIGEST=true
CLAUDE_INVENTORY_DOCKER_MEMORY=1g
CLAUDE_INVENTORY_DOCKER_CPUS=1.0
CLAUDE_INVENTORY_DOCKER_PIDS_LIMIT=128
CLAUDE_INVENTORY_RUN_TIMEOUT_SECONDS=900
CLAUDE_INVENTORY_STOP_TIMEOUT_SECONDS=45
CLAUDE_INVENTORY_RETAIN_FAILED_WORKSPACES=false
# Do NOT put ANTHROPIC_ENVIRONMENT_KEY here. It belongs only in the isolated
# worker launcher environment and must never be available to the Django app.
# Independent runs per money-bearing document. 2 enables disagreement detection
# on every figure; cost scales linearly with this number.
EXTRACTION_RUNS=1
# Optional cross-provider check.
GOOGLE_GENAI_API_KEY=
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=40000000

# --- Photo storage --------------------------------------------------------
# local = write to ./storage, served through an authenticated Django view.
# s3    = any S3-compatible bucket. Cloudflare R2 in production; the
#         docker-compose dev stack runs S3Mock so the code path is identical.
# vercel_blob = a private Vercel Blob store. Vercel injects its token after the
#               store is connected to the project.
STORAGE_DRIVER=s3
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=store-ops-photos
# Dev S3Mock. For R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://localhost:9090
# R2 wants "auto". Real AWS wants a region like us-east-1.
S3_REGION=auto
S3_ACCESS_KEY_ID=store_ops
S3_SECRET_ACCESS_KEY=store_ops_dev_password
# Seconds a presigned photo URL stays valid. Short, because such a URL is a
# bearer credential for a picture of the store's cash position.
SIGNED_URL_TTL_SECONDS=300

# --- Seed accounts --------------------------------------------------------
# Used once by `manage.py seed_accounts` to create the two logins. Kept here
# rather than in the committed seed script, because a PIN in git is a PIN on
# every machine that ever clones this repo.
#
# These are short numeric PINs on an internet-facing app. What actually protects
# them is the 5-attempt lockout in settings/base.py, not their length.
SEED_OWNER_PASSWORD=
SEED_EMPLOYEE_PIN=

# --- Store operating rules ------------------------------------------------
# Eastern: the store's Square Sales Report prints "EDT" and the Florida Lottery
# terminal states all times are Eastern. See docs/sample-documents.md.
STORE_TIMEZONE=America/New_York

# The business day window drives every Square query, so a wrong value silently
# files late-night sales under the wrong date.
#
# 00:00 for this store, NOT a 4am cutoff: Square's own Sales Report covers
# "12:00 AM - 11:59 PM", and the whole point of the app is matching the printout
# the employee photographs. A cutoff that disagrees with Square's window
# guarantees a variance on every single day.
#
# Raise this only for a store whose Square reports are configured to a
# non-calendar day as well.
BUSINESS_DAY_CUTOFF=00:00

# Do lottery sales ring through Square, or only through the lottery terminal?
# Backwards, this double-counts every lottery dollar, so the reconciliation
# engine reads it explicitly rather than inferring it.
LOTTERY_RINGS_THROUGH_POS=false

# Variance, in cents, tolerated before a day is flagged for the owner.
CASH_VARIANCE_TOLERANCE_CENTS=0
